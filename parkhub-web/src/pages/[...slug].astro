---
import '../styles/global.css';
import { App } from '../App.jsx';

export async function getStaticPaths() {
  const routes = [
    undefined, // root
    'login', 'register', 'forgot-password', 'welcome', 'tour',
    'dashboard', 'bookings', 'book', 'credits', 'vehicles',
    'absences', 'profile', 'settings', 'team', 'notifications',
    'calendar', 'map', 'admin', 'admin/settings', 'admin/users',
    'admin/announcements', 'admin/lots', 'admin/zones', 'admin/reports', 'admin/roles',
    'admin/waitlist', 'admin/activity'
  ];
  return routes.map(slug => ({ params: { slug } }));
}
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#0d9488" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#042f2e" media="(prefers-color-scheme: dark)" />
    <meta name="description" content="ParkHub — Smart Parking Management. Book, manage and optimize parking with real-time occupancy, team scheduling, and GDPR-compliant analytics." />
    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="ParkHub" />
    <meta property="og:title" content="ParkHub — Smart Parking Management" />
    <meta property="og:description" content="Book, manage and optimize parking with real-time occupancy, team scheduling, and GDPR-compliant analytics." />
    <meta property="og:image" content="/og-image.svg" />
    <meta property="og:locale" content="en_US" />
    <title>ParkHub</title>
    <script is:inline>
      // Brave Shields / Privacy Mode Defensive Storage Wrapper
      (function() {
        var storageSupported = false;
        try {
          if (typeof window !== 'undefined' && 'localStorage' in window && window.localStorage !== null) {
            window.localStorage.setItem('__storage_test__', '1');
            window.localStorage.removeItem('__storage_test__');
            storageSupported = true;
          }
        } catch (e) {
          storageSupported = false;
        }

        if (!storageSupported) {
          var createMockStorage = function() {
            var mockStore = {};
            return {
              getItem: function(key) { return mockStore[key] ?? null; },
              setItem: function(key, val) { mockStore[key] = String(val); },
              removeItem: function(key) { delete mockStore[key]; },
              clear: function() { mockStore = {}; },
              length: 0,
              key: function(i) { return Object.keys(mockStore)[i] ?? null; }
            };
          };
          try {
            Object.defineProperty(window, 'localStorage', {
              value: createMockStorage(),
              writable: true,
              configurable: true
            });
            Object.defineProperty(window, 'sessionStorage', {
              value: createMockStorage(),
              writable: true,
              configurable: true
            });
          } catch (e) {
            try {
              window.localStorage = createMockStorage();
              window.sessionStorage = createMockStorage();
            } catch (err) {}
          }
        }
      })();
    </script>
  </head>
  <body>
    <div id="app">
      <App client:only="react" />
    </div>
  </body>
</html>
